{{#each shows}}
    <div class="show" data-id="{{this._id}}">
        <div class="poster">
            <img src="https://image.tmdb.org/t/p/w92{{this.external_data.poster_path}}">
        </div>
        <div class="content">
            <div class="header">
                <span class="title">{{this.summary.title}}</span>
                <a href="{{../baseURL}}{{this.summary.the_movie_db_id}}" target="_blank">
                    <i class="fas fa-external-link-alt"></i>
                </a>
            </div>
            <div class="body">
                <span class="scraped">
                    Seasons scraped: {{this.summary.scraped_seasons}} of {{this.summary.aired_seasons}}
                </span>
                <span class="toggleBlacklist">
                    {{#if this.blacklist}}
                        <i class="fas fa-book-dead" title="remove from blacklist"></i>
                    {{else}}
                        <i class="fas fa-book" title="add to blacklist"></i>
                    {{/if}}
                </span>
            </div>
        </div>
    </div>
{{/each}}