<!DOCTYPE html>
<html>
    <head>
        <title>Outdated Seasons</title>
        <meta charset="utf-8" />
        <style>
            .snapshot {
                font-size: 11px;
                margin-top: 15px;
            }
        </style>
    </head>
    <body>
        <h1>Here are some outdated seaons</h1>

        <table>
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Seasons</th>
                    <th>Watched</th>
                </tr>
            </thead>
            <tbody>
                {{#each shows}}
                    <tr>
                        <td><a href="{{../baseURL}}{{this.summary.the_movie_db_id}}" target="_blank">{{this.summary.title}}</a></td>
                        <td>{{this.summary.scraped_seasons}} of {{this.summary.aired_seasons}}</td>
                        <td>{{#if this.summary.watched}}CHECK{{/if}}</td>
                        <td>{{#if this.summary.in_production}}Running{{else}}Ended{{/if}}</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>

        <div class="snapshot">Effective: {{date}}</div>
    </body>
</html>